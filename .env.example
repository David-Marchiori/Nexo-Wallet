# Copie para .env.local (ignorado pelo git) para usar o ditado por voz no `npm run dev`.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# Nunca use o prefixo VITE_: o Vite colocaria a chave no código enviado ao navegador.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-5-5
# ANTHROPIC_MODEL=
